<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 风格的密码列表卡片 -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clipChildren="false"
    android:clipToPadding="false"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:contentPadding="4dp"
    app:shapeAppearance="@style/ShapeAppearance.M3.MediumComponent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- 主内容区域 -->
        <LinearLayout
            android:id="@+id/ll_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- 拖动手柄（三条线图标），默认隐藏 -->
            <ImageView
                android:id="@+id/iv_drag_handle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_drag_handle"
                android:visibility="gone"
                android:contentDescription="拖动排序" />

            <!-- 复选框（批量选择模式），默认隐藏 -->
            <CheckBox
                android:id="@+id/cb_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                android:clickable="false"
                android:focusable="false" />

            <!-- 文字区域 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_item_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tv_item_account"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/tv_item_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:alpha="0.7" />

            </LinearLayout>

            <!-- 三点菜单图标 -->
            <ImageView
                android:id="@+id/iv_three_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:padding="8dp"
                android:src="@drawable/ic_three_dots"
                android:contentDescription="更多选项" />

        </LinearLayout>

        <!-- 置顶标签区域（右上角） -->
        <FrameLayout
            android:id="@+id/fl_pin_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:visibility="gone">

            <!-- 蓝色斜线标签 -->
            <View
                android:id="@+id/view_pin_badge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_pin_badge" />

            <!-- "置顶"文字 -->
            <TextView
                android:id="@+id/tv_pin_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:rotation="0"
                android:text="置顶"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:alpha="0.6"
                android:textSize="10sp" />

        </FrameLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>
