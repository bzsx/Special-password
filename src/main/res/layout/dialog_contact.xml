<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <!-- 第一行：B站 + 作者名 + 主页链接 -->
    <TextView
        android:id="@+id/tv_contact_bili"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="B站：宝藏水仙"
        android:textSize="15sp"
        android:textColor="?attr/colorOnSurface"
        android:lineSpacingExtra="4dp" />

    <TextView
        android:id="@+id/tv_contact_bili_link"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="个人主页：\nhttps://space.bilibili.com/3546612747995937"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimary"
        android:lineSpacingExtra="4dp"
        android:layout_marginTop="2dp"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- 官方网站 -->
    <TextView
        android:id="@+id/tv_contact_website"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="官方网站：\nhttps://bzsx.lhx520.icu/password.html"
        android:textSize="13sp"
        android:textColor="?attr/colorPrimary"
        android:lineSpacingExtra="4dp"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- 第二行：QQ群 + 群号（点击复制） -->
    <TextView
        android:id="@+id/tv_contact_qq"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="QQ群：241333711（点击复制）"
        android:textSize="15sp"
        android:textColor="?attr/colorPrimary"
        android:lineSpacingExtra="4dp"
        android:clickable="true"
        android:focusable="true" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorOutlineVariant"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <!-- 第三行：邮箱 -->
    <TextView
        android:id="@+id/tv_contact_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="邮箱：Gary_cong0605@outlook.com（点击发送邮件）"
        android:textSize="15sp"
        android:textColor="?attr/colorPrimary"
        android:lineSpacingExtra="4dp"
        android:clickable="true"
        android:focusable="true" />

    <!-- 底部关闭键 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_contact_close"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:text="关 闭"
        android:textSize="16sp"
        android:textAllCaps="false"
        app:cornerRadius="28dp" />

</LinearLayout>