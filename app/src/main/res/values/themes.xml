<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ==================== M3 基础主题 ==================== -->
    <style name="Theme.PasswordApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- M3 动态配色核心色（作为壁纸取色不可用时的回退） -->
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorSecondaryContainer">@color/m3_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/m3_on_secondary_container</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorErrorContainer">@color/m3_error_container</item>
        <item name="colorOnErrorContainer">@color/m3_on_error_container</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/m3_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/m3_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/m3_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/m3_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/m3_surface_container_highest</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="colorOutline">@color/m3_outline</item>
        <item name="colorOutlineVariant">@color/m3_outline_variant</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/m3_surface_container</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- M3 形状属性 -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.M3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.M3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.M3.LargeComponent</item>

        <!-- M3 弹性动效（通过主题层覆盖，代码层也已实现） -->
        <item name="motionDurationLong1">375</item>
        <item name="motionDurationMedium1">300</item>
        <item name="motionDurationShort1">200</item>
    </style>

    <!-- M3 形状定义（圆角 + 混合风格，体现"富有表现力"） -->
    <style name="ShapeAppearance.M3.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="ShapeAppearance.M3.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.M3.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- ==================== 详情页深色主题（M3） ==================== -->
    <style name="Theme.PasswordApp.DetailDark">
        <item name="colorPrimary">@color/m3_dark_primary</item>
        <item name="colorOnPrimary">@color/m3_dark_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_dark_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_dark_on_primary_container</item>
        <item name="colorSecondary">@color/m3_dark_secondary</item>
        <item name="colorOnSecondary">@color/m3_dark_on_secondary</item>
        <item name="colorTertiary">@color/m3_dark_tertiary</item>
        <item name="colorOnTertiary">@color/m3_dark_on_tertiary</item>
        <item name="colorError">@color/m3_dark_error</item>
        <item name="colorOnError">@color/m3_dark_on_error</item>
        <item name="colorSurface">@color/m3_dark_surface</item>
        <item name="colorOnSurface">@color/m3_dark_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_dark_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_dark_on_surface_variant</item>
        <item name="android:colorBackground">@color/m3_dark_background</item>
        <item name="colorOnBackground">@color/m3_dark_on_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.M3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.M3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.M3.LargeComponent</item>
    </style>

    <!-- ==================== 详情页浅色主题（M3） ==================== -->
    <style name="Theme.PasswordApp.DetailLight">
        <item name="colorPrimary">@color/m3_primary</item>
        <item name="colorOnPrimary">@color/m3_on_primary</item>
        <item name="colorPrimaryContainer">@color/m3_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/m3_on_primary_container</item>
        <item name="colorSecondary">@color/m3_secondary</item>
        <item name="colorOnSecondary">@color/m3_on_secondary</item>
        <item name="colorTertiary">@color/m3_tertiary</item>
        <item name="colorOnTertiary">@color/m3_on_tertiary</item>
        <item name="colorError">@color/m3_error</item>
        <item name="colorOnError">@color/m3_on_error</item>
        <item name="colorSurface">@color/m3_surface</item>
        <item name="colorOnSurface">@color/m3_on_surface</item>
        <item name="colorSurfaceVariant">@color/m3_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/m3_on_surface_variant</item>
        <item name="android:colorBackground">@color/m3_background</item>
        <item name="colorOnBackground">@color/m3_on_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.M3.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.M3.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.M3.LargeComponent</item>
    </style>
</resources>
