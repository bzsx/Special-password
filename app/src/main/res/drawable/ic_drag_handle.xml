<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="24dp"
        android:height="24dp"
        android:gravity="center">
        <rotate
            android:fromDegrees="90"
            android:pivotX="50%"
            android:pivotY="50%">
            <layer-list>
                <!-- 三条水平线 -->
                <item
                    android:width="20dp"
                    android:height="2dp"
                    android:gravity="center_horizontal|top"
                    android:top="4dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#888888" />
                    </shape>
                </item>
                <item
                    android:width="20dp"
                    android:height="2dp"
                    android:gravity="center"
                    android:top="11dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#888888" />
                    </shape>
                </item>
                <item
                    android:width="20dp"
                    android:height="2dp"
                    android:gravity="bottom|center_horizontal"
                    android:bottom="4dp">
                    <shape android:shape="rectangle">
                        <solid android:color="#888888" />
                    </shape>
                </item>
            </layer-list>
        </rotate>
    </item>
</layer-list>