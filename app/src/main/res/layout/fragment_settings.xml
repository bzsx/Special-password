<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ===== 关于信息区域 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textColor="?attr/colorOnSurface"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tv_changelog"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更新日志"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:clickable="true"
                android:focusable="true"
                android:paddingVertical="8dp"
                android:paddingEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textSize="12sp"
                android:textColor="?attr/colorOutlineVariant"
                android:paddingHorizontal="4dp" />

            <TextView
                android:id="@+id/tv_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="联系作者"
                android:textSize="14sp"
                android:textColor="?attr/colorPrimary"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="8dp"
                android:paddingStart="8dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- 直接检查更新按钮 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_direct_check_update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用唯一联网功能：直接检查更新"
            android:textSize="13sp"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <View
            android:layout_width="64dp"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/maker"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tv_github"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/github_link"
            android:textSize="16sp"
            android:textColor="?attr/colorPrimary"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true"
            android:padding="6dp"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp" />

        <!-- ===== 主题色自定义 ===== -->
        <LinearLayout
            android:id="@+id/layout_theme_color"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="主题色自定义"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_theme_color_preview"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="#FF2E7D32"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- ===== 开屏动画开关 ===== -->
        <LinearLayout
            android:id="@+id/layout_splash"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开屏动画"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_splash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- ===== 深色模式 ===== -->
        <LinearLayout
            android:id="@+id/layout_dark_mode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="深色模式"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_dark_mode_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="跟随系统"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- ===== 解锁方式 ===== -->
        <LinearLayout
            android:id="@+id/layout_unlock_mode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="解锁方式"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_unlock_mode_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主密码"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- ===== 修改密码 ===== -->
        <LinearLayout
            android:id="@+id/layout_change_password"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="修改主密码"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- ===== 添加背景图片 ===== -->
        <LinearLayout
            android:id="@+id/layout_select_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="添加背景图片"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tv_bg_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未设置"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- 背景图片选项（已启用时显示透明度调节） -->
        <LinearLayout
            android:id="@+id/layout_bg_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="透明度："
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface" />

            <SeekBar
                android:id="@+id/seekbar_alpha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="8dp"
                android:max="99" />

            <TextView
                android:id="@+id/tv_alpha_value"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="80%"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="end" />

        </LinearLayout>

        <!-- 关闭使用背景图片 -->
        <LinearLayout
            android:id="@+id/layout_disable_bg"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="0dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="关闭使用背景图片"
                android:textSize="16sp"
                android:textColor="?attr/colorError"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp" />

        <!-- ===== 声明 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/disclaimer"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:alpha="0.7"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>